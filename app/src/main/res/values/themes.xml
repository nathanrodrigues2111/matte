<resources>
    <style name="Theme.Matte" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="materialCardViewStyle">@style/Matte.Card</item>
    </style>

    <style name="Matte.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- AMOLED: pure black canvas, near-black cards with a hairline outline. Accents stay dynamic. -->
    <style name="ThemeOverlay.Matte.Amoled" parent="">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#0D0D0D</item>
        <item name="colorSurfaceContainerHigh">#101010</item>
        <item name="colorSurfaceContainerHighest">#121212</item>
        <item name="colorOutlineVariant">#14FFFFFF</item>
        <item name="materialCardViewStyle">@style/Matte.Card.Amoled</item>
    </style>

    <style name="Matte.Card.Amoled" parent="Matte.Card">
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#14FFFFFF</item>
    </style>
</resources>
